# Servidor HTTP
PORT=4000
NODE_ENV=development

# Origem autorizada a consumir a API (frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# Ligação PostgreSQL usada pelo Prisma.
# Formato: postgresql://UTILIZADOR:PALAVRA_PASSE@HOST:PORTA/BASE?schema=public
# Substituir apenas com credenciais locais de desenvolvimento num ficheiro .env (nunca versionado).
DATABASE_URL="postgresql://bancaflow:bancaflow@localhost:5432/bancaflow?schema=public"

# Autenticação — substituir por um valor aleatório longo em cada ambiente.
JWT_SECRET="substituir-por-segredo-aleatorio-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# Limitação de pedidos nas rotas de autenticação.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=900000
